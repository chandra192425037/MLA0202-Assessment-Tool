import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.mixture import GaussianMixture
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score
data = pd.read_csv("E:\datasets\question2_digits_clustering.csv")
print(data.head())
X = data.drop("SampleID", axis=1)
kmeans = KMeans(
    n_clusters=5,
    random_state=42,
    n_init=10
)
k_labels = kmeans.fit_predict(X)
gmm = GaussianMixture(
    n_components=5,
    random_state=42
)
g_labels = gmm.fit_predict(X)
print("K-Means Score:",
      silhouette_score(X, k_labels))
print("GMM Score:",
      silhouette_score(X, g_labels))
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)
plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=k_labels
)
plt.xlabel("PCA 1")
plt.ylabel("PCA 2")
plt.title("K-Means Clustering")
plt.show()
plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=g_labels
)
plt.xlabel("PCA 1")
plt.ylabel("PCA 2")
plt.title("GMM Clustering")
plt.show()

