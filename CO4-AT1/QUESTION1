from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination
m = DiscreteBayesianNetwork([('O','D'),('S','D')])
o = TabularCPD('O',2,[[0.7],[0.3]],state_names={'O':['No','Yes']})
s = TabularCPD('S',2,[[0.6],[0.4]],state_names={'S':['No','Yes']})
d = TabularCPD('D',2,
    [[0.95,0.6,0.7,0.1],
     [0.05,0.4,0.3,0.9]],
    evidence=['O','S'],evidence_card=[2,2],
    state_names={'D':['No','Yes'],'O':['No','Yes'],'S':['No','Yes']})
m.add_cpds(o,s,d)
r = VariableElimination(m).query(['D'],{'O':'Yes','S':'Yes'})
print(r)
print("Diabetes probability:",r.values[1])
