import numpy as np
n_components = 3
startprob = np.array([0.7, 0.2, 0.1])
transmat = np.array([
    [0.8, 0.15, 0.05],
    [0.2, 0.6, 0.2],
    [0.05, 0.25, 0.7]
])
emissionprob = np.array([
    [0.8, 0.15, 0.05],
    [0.2, 0.6, 0.2],
    [0.05, 0.25, 0.7]
])
observations = np.array([0, 0, 1, 1, 2])
T = len(observations)
dp = np.zeros((T, n_components))
backpointer = np.zeros((T, n_components), dtype=int)
dp[0] = startprob * emissionprob[:, observations[0]]
for t in range(1, T):
    for current_state in range(n_components):
        probabilities = (
            dp[t - 1]
            * transmat[:, current_state]
            * emissionprob[current_state, observations[t]]
        )
        backpointer[t, current_state] = np.argmax(probabilities)
        dp[t, current_state] = np.max(probabilities)
states = np.zeros(T, dtype=int)
states[-1] = np.argmax(dp[-1])
for t in range(T - 2, -1, -1):
    states[t] = backpointer[t + 1, states[t + 1]]
names = ["Healthy", "Warning", "Failure"]
print("Predicted Machine States:")
for state in states:
    print(names[state])
