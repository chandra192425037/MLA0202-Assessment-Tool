from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination
model = DiscreteBayesianNetwork([
    ("Amount", "Fraud"),
    ("Location", "Fraud"),
    ("Device", "Fraud"),
    ("History", "Fraud")
])
c1 = TabularCPD("Amount", 2, [[0.7], [0.3]])
c2 = TabularCPD("Location", 2, [[0.8], [0.2]])
c3 = TabularCPD("Device", 2, [[0.75], [0.25]])
c4 = TabularCPD("History", 2, [[0.85], [0.15]])
c5 = TabularCPD(
    "Fraud", 2,
    [[0.99, 0.90, 0.85, 0.70, 0.80, 0.60, 0.50, 0.30,
         0.90, 0.70, 0.60, 0.40, 0.70, 0.50, 0.35, 0.15],
        [0.01, 0.10, 0.15, 0.30, 0.20, 0.40, 0.50, 0.70,
         0.10, 0.30, 0.40, 0.60, 0.30, 0.50, 0.65, 0.85]],
    evidence=["Amount", "Location", "Device", "History"],
    evidence_card=[2, 2, 2, 2]
)
model.add_cpds(c1, c2, c3, c4, c5)
print("Model Valid:", model.check_model())
infer = VariableElimination(model)
result = infer.query(
    ["Fraud"],
    evidence={
        "Amount": 1,
        "Location": 1,
        "Device": 1,
        "History": 1
    })
print(result)
print("Probability of Fraud:", result.values[1])
