from sklearn.linear_model import LogisticRegression
X = [
    [5, 3, 2],
    [1, 0, 0],
    [4, 2, 3],
    [0, 1, 0],
    [6, 4, 2]
]
y = [1, 0, 1, 0, 1]
model = LogisticRegression()
model.fit(X, y)
free = int(input("Enter 'free' word count: "))
offer = int(input("Enter 'offer' word count: "))
win = int(input("Enter 'win' word count: "))
result = model.predict([[free, offer, win]])
if result[0] == 1:
    print("Spam Email")
else:
    print("Not Spam Email")
