import numpy as np
ads = 5
rounds = 10000
probability = [0.05, 0.08, 0.12, 0.07, 0.10]
count = np.zeros(ads)
reward = np.zeros(ads)
for t in range(1, rounds + 1):
    if t <= ads:
        ad = t - 1
    else:
        average = reward / count
        ucb = average + np.sqrt(2 * np.log(t) / count)
        ad = np.argmax(ucb)
    click = np.random.rand() < probability[ad]
    count[ad] += 1
    reward[ad] += click
print("Advertisement Results:")
for i in range(ads):
    print("Ad", i + 1, "CTR:", reward[i] / count[i])
print("Total Clicks:", int(sum(reward)))
